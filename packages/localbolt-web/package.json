{
  "name": "@localbolt/web",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "LocalBolt — Encrypted P2P File Transfer",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run generate:static-shell",
    "build:client": "vite build",
    "generate:static-shell": "node scripts/generate-static-shell.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@the9ines/bolt-core": "^0.6.4",
    "@the9ines/localbolt-browser": "0.1.1",
    "@the9ines/localbolt-core": "0.1.4",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  }
}
