{
  "name": "@the9ines/localbolt-browser",
  "version": "0.1.1",
  "description": "Browser-layer components, signaling, persistence, and state for LocalBolt web apps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "wasm"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "@the9ines/bolt-core": ">=0.6.0"
  },
  "devDependencies": {
    "@the9ines/bolt-core": "^0.6.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
